# ── Supabase (reuse your existing project) ──────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Mailgun (email) ──────────────────────────────────────────────────
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
CONTACT_TO_EMAIL=you@elitesmarthome.com
CONTACT_FROM_EMAIL=EliteWorker Site <site@yourdomain.com>

# ── Cal.com (demo booking) ───────────────────────────────────────────
NEXT_PUBLIC_CAL_LINK=your-username/eliteworker-demo

# ── Admin dashboard (/admin) ─────────────────────────────────────────
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# ── Cloudflare Turnstile (bot protection on all forms) ────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Beta email verification (signs the code + verified-email tokens) ──
EMAIL_VERIFY_SECRET=

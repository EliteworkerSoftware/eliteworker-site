# ── Supabase (reuse your existing project) ──────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Mailgun (email) ──────────────────────────────────────────────────
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
CONTACT_TO_EMAIL=you@elitesmarthome.com
CONTACT_FROM_EMAIL=EliteWorker Site <site@yourdomain.com>

# ── Cal.com (demo booking) ───────────────────────────────────────────
NEXT_PUBLIC_CAL_LINK=your-username/eliteworker-demo

# ── Admin dashboard (/admin) ─────────────────────────────────────────
ADMIN_SESSION_SECRET=

# ── Demo booking day-before reminder (scheduled by vercel.json) ───────
# CRON_SECRET: any long random string — must match what you set in Vercel's
# Cron Job settings so /api/cron/demo-reminders only runs for real cron calls.
CRON_SECRET=
# DEMO_CONFIRM_SECRET: optional — signs the "I'll be there" link in the
# reminder email. Falls back to ADMIN_SESSION_SECRET if left unset.
DEMO_CONFIRM_SECRET=

# ── Cloudflare Turnstile (bot protection on all forms) ────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Beta email verification (signs the code + verified-email tokens) ──
EMAIL_VERIFY_SECRET=

# ── Twilio (SMS alerts to you on new leads/signups/bookings) ──────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ALERT_PHONE_NUMBER=
